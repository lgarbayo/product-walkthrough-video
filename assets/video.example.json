{
  "title": "Fieldnote",
  "language": "en",
  "maxSeconds": 180,
  "marginSeconds": 6,
  "baseUrl": "http://127.0.0.1:4310",
  "device": "phone",
  "viewports": {
    "phone": {
      "width": 390,
      "height": 844
    },
    "browser": {
      "width": 1280,
      "height": 800
    }
  },
  "locale": "en-US",
  "css": "nextjs-portal, [data-nextjs-toast] { display: none !important; }",
  "brand": {
    "name": "Fieldnote",
    "logo": "cards/logo.svg"
  },
  "theme": {
