      "placeholder": "#E3E1DB",
      "row-line": "#DAD8D2",
      "row-ink": "#24231F",
      "row-value": "#45433E",
      "tag-ink": "#24231F",
      "term-bg": "#1C1B19",
      "term-line": "#33312D",
      "term-dot": "#45433E",
      "term-dim": "#97948C",
      "term-ink": "#EDEBE5",
      "term-out": "#C2BFB8",
      "term-ok": "#8FC79A",
      "term-key": "#F5D547",
      "term-link": "#B7C9D6",
      "term-shadow": "none",
      "nav-todo": "#B9B7B0",
      "nav-past": "#6E6B64",
      "nav-cur": "#1C1B19",
      "dot": "#1C1B19"
    },
    "accents": {
      "pass": "#2E6B3A",
      "fail": "#A3271E"
    },
    "fonts": {
      "sans": {
        "family": "Barlow",
        "files": [
          {
            "src": "../../node_modules/@fontsource/barlow/files/barlow-latin-300-normal.woff2",
            "weight": 300
          },
          {
            "src": "../../node_modules/@fontsource/barlow/files/barlow-latin-400-normal.woff2",
            "weight": 400
          },
          {
            "src": "../../node_modules/@fontsource/barlow/files/barlow-latin-500-normal.woff2",
            "weight": 500
          },
          {
            "src": "../../node_modules/@fontsource/barlow/files/barlow-latin-600-normal.woff2",
            "weight": 600
          }
        ]
      },
      "mono": {
        "family": "Overpass Mono",
        "files": [
          {
            "src": "../../node_modules/@fontsource/overpass-mono/files/overpass-mono-latin-400-normal.woff2",
            "weight": 400
          },
          {
            "src": "../../node_modules/@fontsource/overpass-mono/files/overpass-mono-latin-500-normal.woff2",
            "weight": 500
          }
        ]
      }
