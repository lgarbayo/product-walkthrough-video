    "radius": {
      "card": 2,
      "box": 2,
      "chip": 2,
      "pill": 2,
      "code": 2,
      "tag": 2,
      "term": 4,
      "browser": 4
    },
    "background": "#D8D7D2",
    "motif": {
      "kind": "svg",
      "src": "cards/motif.svg",
      "closing": "above"
    },
    "css": ".eyebrow,.bts-t,.ctitle{text-transform:uppercase;letter-spacing:.08em;}"
  },
  "event": "Product walkthrough · 2026",
  "links": {
    "demo": "fieldnote.example.dev",
    "repo": "github.com/team/fieldnote"
  },
  "setup": [
    {
      "method": "POST",
      "url": "/api/demo/reset"
    }
  ],
  "voice": {
    "name": "George",
    "model": "eleven_multilingual_v2",
    "stability": 0.55,
    "similarity": 0.8,
    "style": 0.12,
    "speed": 1,
    "lead": 0.4,
    "pause": 1.2
  },
  "music": {
    "_comment": "Optional music bed (references/format.md, Music). Remove it, or pass --no-music, for a voice-only video like the reference.",
    "src": "music/bed.mp3",
    "start": 0,
    "bedLufs": -22,
    "duckDb": 9,
    "pad": 0.2,
    "ramp": 0.35,
    "fadeIn": 1.5,
    "fadeOut": 3
  },
  "scenes": [
    {
      "id": "intro",
      "kind": "intro",
      "headline": [
        "You inspect.",
        {
          "muted": "Fieldnote writes"
        },
        "the report."
      ],
      "subtitle": "Product and architecture walkthrough",
      "voice": "This is Fieldnote. You inspect, Fieldnote writes the report. Here's the product, and how it's built."
    },
    {
      "id": "problem",
      "kind": "problem",
      "headline": [
        "Inspections take an hour.",
        {
          "muted": "The report takes two more."
        }
      ],
      "stats": [
        {
          "value": "2 h",
          "text": "of paperwork after every site visit.",
          "source": "Source: the survey you cite, year",
          "cue": "two hours"
        },
        {
          "value": "1 in 3",
          "text": "reports are filed after the deadline.",
          "source": "Source: the second source, year",
          "cue": "one in three"
        },
        {
          "value": "4 forms",
          "text": "per visit: photos, findings, risks, sign-off.",
          "source": "What Fieldnote fills with you",
          "cue": "four forms"
        }
      ],
      "flow": [
        "Walk",
        "Talk",
        "Findings",
        "Report",
        "Sign-off"
      ],
      "promise": "Filed before you leave the site",
      "cueFlow": "while you walk",
      "voice": "Every site visit ends with two hours of paperwork, and one in three reports is late. Four forms per visit. Fieldnote fills them while you walk the site."
    },
    {
      "id": "arch",
      "kind": "architecture",
      "headline": [
        "One server.",
        {
          "muted": "Two external services."
        }
      ],
      "columns": [
        {
          "title": "Clients",
          "width": 1,
          "boxes": [
            {
              "id": "app",
              "title": "Phone app",
              "body": "Pages in `src/app`, camera, dictation",
              "cue": "phone app"
            },
            {
              "id": "mcp",
              "title": "MCP client",
              "body": "Claude Desktop / Code",
              "cue": "MCP"
            }
          ]
        },
        {
          "title": "Next.js server · TypeScript · one process",
          "frame": true,
          "width": 2.2,
          "grid": 2,
          "boxes": [
            {
              "id": "api",
              "title": "API routes",
              "body": "`src/app/api/*`, zod-validated",
              "cue": "API routes"
            },
            {
              "id": "ai",
              "title": "AI layer",
              "body": "Tiers, limits, deterministic mocks",
              "cue": "AI layer"
            },
            {
              "id": "tools",
              "title": "Tools registry",
              "body": "6 tools: app + MCP",
              "cue": "tools"
            },
            {
              "id": "store",
              "title": "JSON store",
              "body": "One file, atomic writes",
              "cue": "store"
            }
          ]
        },
        {
          "title": "Services and data",
          "width": 1.1,
          "boxes": [
            {
              "id": "claude",
              "title": "Anthropic API · Claude",
              "body": "Haiku for turns, Sonnet for reports",
              "strong": true,
              "cue": "Claude"
            },
            {
              "id": "disk",
              "title": "Volume /data",
              "body": "db.json, photos, PDFs",
              "cue": "volume"
            }
          ]
        }
      ],
      "arrows": [
        {
          "from": "app",
          "to": "api",
          "strong": true
        },
        {
          "from": "mcp",
          "to": "tools"
        },
        {
          "from": "api",
          "to": "ai"
        },
        {
          "from": "tools",
          "to": "store"
        },
        {
          "from": "ai",
          "to": "claude",
          "strong": true
        },
        {
          "from": "store",
          "to": "disk"
        }
      ],
      "voice": "The phone app and any MCP client talk to one Next.js server. API routes validate every request. The AI layer calls Claude, the tools registry serves both doors, and the store writes one JSON file to a volume."
    },
    {
      "id": "walk",
      "kind": "chapter",
      "name": "Walk the site",
      "headline": [
        "She talks.",
        "The findings write themselves."
      ],
      "route": "/inspect",
      "cards": [
        {
          "label": "Browser",
          "text": "**Web Speech API**, en-US. Each final phrase is a turn in an ordered `TurnQueue`.",
          "cue": "each phrase"
        },
        {
          "label": "Claude Haiku",
          "text": "Returns a **patch**: finding fields plus the photo ids it cites, in about **1.8 seconds** per turn.",
          "cue": "patch"
        }
      ],
      "note": "Microphone input simulated for this recording",
      "steps": [
        {
          "request": {
            "method": "POST",
            "url": "/api/demo/reset"
          }
        },
        {
          "goto": "/inspect?lang=en"
        },
        {
          "waitFor": "[data-testid=finding-list]"
        },
        {
          "mark": "in"
        },
        {
          "wait": 800
        },
        {
          "click": "[data-testid=demo-dictate]"
        },
        {
          "waitFor": "[data-testid=finding-row] >> nth=2",
          "timeout": 30000,
          "after": 1500
        },
        {
          "scroll": "[data-testid=report-preview]",
          "after": 1500
        }
      ],
      "voice": "Ana walks the site and talks. Each phrase becomes a turn. Claude returns a patch, the findings and the photos they cite, in about one point eight seconds per turn."
    },
    {
      "id": "signoff",
      "kind": "chapter",
      "name": "Sign-off",
      "device": "browser",
      "headline": [
        "The manager reviews.",
        {
          "muted": "Nothing is filed without her."
        }
      ],
      "route": "POST /api/reports/:id/sign",
      "cards": [
        {
          "label": "Rule",
          "text": "Code, not the model, decides when a report is **complete**: 4 forms, every risk rated.",
          "cue": "complete",
          "accent": "pass"
        },
        {
          "label": "Measured",
          "text": "From site to signed report in **11 minutes** on the demo case.",
          "cue": "eleven minutes"
        }
      ],
      "manual": "Sign-off with the manager's sandbox account (2FA). Record the browser window at 1280x800 and save it as video/takes/signoff.mp4",
      "take": "takes/signoff.mp4",
      "voice": "At the office, the manager reviews it. Code decides when a report is complete, and nothing is filed without her. On the demo case: eleven minutes from site to signed report."
    },
    {
      "id": "hood",
      "kind": "cards",
      "eyebrow": "Under the hood · AI",
      "headline": [
        "Claude where it adds value.",
        {
          "muted": "Code where it must be exact."
        }
      ],
      "panels": [
        {
          "tag": "src/server/ai",
          "title": "Interface + mocks",
          "cue": "interface",
          "rows": [
            {
              "k": "Each feature slice",
              "v": "real | mock"
            },
            {
              "k": "One real path",
              "v": "structured() → zod"
            },
            {
              "k": "Bad output",
              "v": "AiError, or a safe fallback"
            },
            {
              "k": "Test suite, no key",
              "v": "640 tests"
            }
          ]
        },
        {
          "tag": "src/contracts/env.ts",
          "title": "Tiers, not model names",
          "cue": "tiers",
          "rows": [
            {
              "k": "fast",
              "v": "Haiku"
            },
            {
              "k": "careful",
              "v": "Sonnet"
            }
          ]
        }
      ],
      "voice": "Every AI feature sits behind one interface with a deterministic mock, so six hundred and forty tests run without a key. Features ask for tiers, not model names."
    },
    {
      "id": "mcp",
      "kind": "terminal",
      "eyebrow": "Under the hood · MCP",
      "headline": [
        "One tools module,",
        {
          "muted": "two front doors."
        }
      ],
      "tag": "/api/mcp · Streamable HTTP",
      "bar": "MCP client → http://localhost:4310/api/mcp (real output from this recording)",
      "lines": [
        {
          "t": "node mcp-client.mjs   ~~# Bearer fn_•••• (token from /account)~~",
          "kind": "cmd"
        },
        {
          "t": "connected to __http://localhost:4310/api/mcp__ · Streamable HTTP",
          "kind": "ok",
          "cue": "connects"
        },
        {
          "t": "6 tools: **list_sites**, **get_findings**, **add_finding**, **draft_report**, **export_pdf**, **sign_report**",
          "kind": "ok",
          "cue": "six tools"
        },
        {
          "t": "**list_sites** ~~{\"limit\":3}~~",
          "kind": "call",
          "cue": "lists"
        }
      ],
      "voice": "The same tools module is an MCP server. A client connects, sees six tools, and lists the sites."
    },
    {
      "id": "built",
      "kind": "built",
      "headline": [
        "22 hours, two people,",
        {
          "muted": "AI coding agents in parallel."
        }
      ],
      "timeline": [
        {
          "when": "Nov 13 · evening",
          "text": "Brief + binding spec"
        },
        {
          "when": "scaffold",
          "text": "Shared zod contracts"
        },
        {
          "when": "overnight",
          "text": "9 work packages, disjoint files"
        },
        {
          "when": "Nov 14",
          "text": "One integrator merges main"
        },
        {
          "when": "Nov 14 · 19:00",
          "text": "Live demo on stage"
        }
      ],
      "numbers": [
        {
          "value": "22 h",
          "text": "from brief to demo"
        },
        {
          "value": "9",
          "text": "parallel work packages"
        },
        {
          "value": "14",
          "text": "decision records"
        },
        {
          "value": "640",
          "text": "tests, no key needed"
        },
        {
          "value": "6",
          "text": "MCP tools, one registry"
        }
      ],
      "footer": {
        "label": "Read them all",
        "chips": [
          "docs/ARCHITECTURE_DECISIONS.md",
          "docs/SPEC.md"
        ]
      },
      "voice": "Twenty-two hours, two people, and coding agents in parallel: a binding spec, shared contracts, nine work packages, one integrator."
    },
    {
      "id": "closing",
      "kind": "closing",
      "headline": [
        "You inspect;",
        {
          "muted": "Fieldnote files."
        }
      ],
      "voice": "Fieldnote. You inspect; Fieldnote files."
    }
  ]
}
