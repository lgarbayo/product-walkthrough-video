      "on-ink": "#F1F0EC",
      "pill": "#1C1B19",
      "pill-ink": "#F5D547",
      "pill-outline": "#F1F0EC",
      "shadow": "none",
      "col-line": "#A7A49C",
      "frame-line": "#1C1B19",
      "box": "#F1F0EC",
